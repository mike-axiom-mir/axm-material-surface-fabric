{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axm-material-response",
  "title": "AXM material response organ and pack",
  "description": "Shape check only. Passing this says the record is well formed; it says nothing about whether the behaviour is correct in any renderer. Evidence is earned by a host, never by a validator.",
  "definitions": {
    "evidence": { "enum": ["inferred_candidate_not_tested", "structurally_possible_not_tested", "declared_contract_match_not_tested", "verified_payload_sha256", "verified_render_receipt"] },
    "input": { "type": "object", "required": ["id", "means"], "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "type": { "enum": ["scalar", "vec3", "color", "bool", "int", "enum", "list"] },
      "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
      "options": { "type": "array" }, "default": {}, "means": { "type": "string", "minLength": 8 } } },
    "organ": { "type": "object",
      "required": ["format", "version", "id", "name", "purpose", "inputs", "outputs", "host_binding", "evidence", "known_losses", "fallback", "verify"],
      "properties": {
        "format": { "const": "axm-material-response-organ" },
        "id": { "type": "string", "pattern": "^surface\\.[a-z_]+$" },
        "purpose": { "type": "string", "minLength": 20 },
        "inputs": { "type": "array", "items": { "$ref": "#/definitions/input" }, "minItems": 1 },
        "outputs": { "type": "array", "minItems": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "state_effects": { "const": "none" },
        "host_binding": { "type": "object", "required": ["requires", "binding_note"] },
        "evidence": { "$ref": "#/definitions/evidence" },
        "known_losses": { "type": "array", "items": { "type": "string", "minLength": 10 }, "minItems": 1 },
        "fallback": { "type": "object", "required": ["when", "do", "loses"] },
        "verify": { "type": "array", "items": { "type": "string", "minLength": 20 }, "minItems": 1 } } }
  },
  "oneOf": [
    { "$ref": "#/definitions/organ" },
    { "type": "object", "required": ["format", "families"], "properties": {
      "format": { "const": "axm-material-response-pack" },
      "families": { "type": "array", "items": { "type": "object", "required": ["id", "purpose", "response"] } } } }
  ]
}
